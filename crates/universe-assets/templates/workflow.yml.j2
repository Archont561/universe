# @generated by universe << generator >> — manifest sha256:<< manifest_digest >>
#
# Source of truth: universe.toml. Edit the manifest or the template, never this file.
# `universe ci render` writes it; `universe ci check` fails when the two disagree.
name: << name >>

on:
{%- for trigger in triggers %}
  << trigger.event >>:
{%- for filter in trigger.filters %}
    << filter.key >>: [<< filter.values | join(", ") >>]
{%- endfor %}
{%- endfor %}
permissions:
  contents: read

concurrency:
  group: << name >>-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
{%- for job in jobs %}
  << job.id >>:
    name: << job.name >>
    runs-on: << job.runs_on >>
{%- if job.needs | length %}
    needs: [<< job.needs | join(", ") >>]
{%- endif %}
{%- if job.always %}
    if: always()
{%- endif %}
{%- if job.permissions | length %}
    permissions:
{%- for permission in job.permissions %}
      << permission.scope >>: << permission.access >>
{%- endfor %}
{%- endif %}
{%- if job.matrix | length %}
    strategy:
      fail-fast: << job.fail_fast >>
      matrix:
        << job.matrix_key >>: [<< job.matrix | join(", ") >>]
{%- endif %}
{%- if job.env | length %}
    env:
{%- for variable in job.env %}
{%- if variable.secret %}
      << variable.name >>: ${{ secrets.<< variable.secret >> }}
{%- else %}
      << variable.name >>: << variable.expression >>
{%- endif %}
{%- endfor %}
{%- endif %}
    steps:
{%- for step in job.steps %}
{%- if step.uses %}
      - uses: << step.uses >>
{%- else %}
      - name: << step.label >>
        run: |
          << step.run >>
{%- endif %}
{%- endfor %}
{%- endfor %}
